# Beispiel-Konfiguration für VoxCPM im LXC (wird nach /etc/voxcpm/voxcpm.conf geschrieben)
WEB_HOST=0.0.0.0
WEB_PORT=8808
MODEL_ID=openbmb/VoxCPM2
DEVICE=cpu
# DEVICE-Optionen: cpu (LXC-Default) | auto | cuda | cuda:0 | mps
# MODEL-Optionen: openbmb/VoxCPM2 (~8GB VRAM, 30 Sprachen, empfohlen)
#                 openbmb/VoxCPM1.5 (~6GB VRAM, nur zh/en)
#                 openbmb/VoxCPM-0.5B (~5GB VRAM, legacy)
